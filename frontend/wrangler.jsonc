// Cloudflare Workers project of the frontend (Workers Builds: root directory `frontend`,
// build command `npm run build`). The built site is served as static assets; /api/* goes to
// the worker, which proxies it to API_ORIGIN (a variable set in the dashboard; keep_vars keeps it).
{
  "name": "sourcebound",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "previews": {},
  "observability": { "enabled": true }
}
