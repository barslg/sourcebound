# Copy to .env and fill in values. Never commit .env.
# Every name here is read by src/app/config.py; no values are stored in the repo.
APP_ENV=
LOG_LEVEL=
DATABASE_URL=
TEST_DATABASE_URL=
MODEL_API_KEY=
# Encrypts the per-user Meta keys at rest (account page); any long random string.
MODEL_KEY_SECRET=
MODEL_API_BASE_URL=
MODEL_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=
ANTHROPIC_WORKSPACE_ID=
LLM_DEFAULT_MODEL=
LLM_DEV_MODE=
LLM_SPEND_CEILING_USD=
MODEL_REPLAY_LEDGER=
API_HOST=
API_PORT=
# Host loopback port of the web container (docker-compose.yml); the host's reverse proxy points here.
WEB_PORT=
LLM_CONNECT_TIMEOUT_S=
LLM_READ_TIMEOUT_S=
LLM_POLL_TIMEOUT_S=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET_KEY=
SUPERADMIN_EMAILS=
SESSION_COOKIE_NAME=
SESSION_TTL_S=
SESSION_SECURE_COOKIE=
OIDC_ISSUER=
OIDC_REDIRECT_URL=
OIDC_ALLOWED_DOMAINS=
OIDC_HTTP_TIMEOUT_S=
SSE_PING_S=
SOURCE_STORE_PATH=
SOURCE_FETCH_TIMEOUT_S=
SOURCE_FETCH_MAX_BYTES=
MASTERY_THRESHOLD=
ANSWER_MAX_BYTES=
TUTOR_MIN_SCORE=
TUTOR_MIN_COVERED=
TUTOR_MAX_PASSAGES=
TUTOR_QUESTION_MAX_CHARS=
